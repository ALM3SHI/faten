# Copy this file to .env and fill in your keys. .env is git-ignored.

# AI provider for the chat agent and other AI features: gemini (default) or openai
AI_PROVIDER=gemini

# Gemini — required when AI_PROVIDER=gemini (free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# OpenAI — only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional — AI study plan generator (any OpenAI-compatible provider)
LLAMA_API_KEY=
LLAMA_BASE_URL=https://openrouter.ai/api/v1
LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional — voice input (Groq Whisper); without it the browser's speech API is used
GROQ_API_KEY=

# Firebase Admin service account file (git-ignored)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Comma-separated frontend origins. Use "*" only for local development.
ALLOWED_ORIGINS=http://localhost:3000

# Daily AI credits per user (chat message = 1, plan/schedule vision = 5). 0 disables.
DAILY_AI_CREDITS=60

# Optional — error tracking (free tier at sentry.io). Needs: pip install "sentry-sdk[fastapi]"
SENTRY_DSN=
