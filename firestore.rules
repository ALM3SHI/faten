rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  Faten — Firestore Security Rules
// ════════════════════════════════════════════════════════════════
//  • The backend uses the Firebase Admin SDK, which bypasses these
//    rules — so everything the server needs keeps working.
//  • The browser may only touch its OWN documents under users/{uid}.
//  • Everything else (ai_usage, future shared collections, …) is
//    closed to clients by default.
//
//  Deploy:  firebase deploy --only firestore:rules
//  or paste this file into Firebase Console → Firestore → Rules.
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields only the server may set (subscription tier, admin flags).
    function serverOnlyFields() {
      return ['role', 'isAdmin', 'plan_tier', 'subscription', 'quota'];
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.get('uid', uid) == uid
        && !request.resource.data.keys().hasAny(serverOnlyFields());

      allow update: if isOwner(uid)
        && request.resource.data.get('uid', uid) == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyFields());

      // academic_record, plan, chats, chat_history, notifications, …
      // `coll` is the first sub-collection name; `rest` matches the
      // document and anything nested under it.
      match /{coll}/{rest=**} {
        allow read, delete: if isOwner(uid);
        // Agent memory is written only by the server (it filters sensitive
        // facts and caps the size before the text reaches the AI prompt);
        // the student can still read and delete it.
        // The dynamic study mode (tutor_lectures: mastery evidence, exam
        // results) is written only by the server so scores cannot be edited
        // from the browser. Academic-advisor results (advisor_runs) are
        // server-computed for the same reason.
        allow create, update: if isOwner(uid) && coll != 'agent_memory' && coll != 'tutor_lectures' && coll != 'advisor_runs';
      }
    }

    // tutor_cache (shared lecture analysis), tutor_stats (anonymous
    // aggregates) and instructor_reviews (verified student reviews) are
    // server-only: they fall under the default deny below.

    // Default deny — anything not matched above is unreachable from clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
